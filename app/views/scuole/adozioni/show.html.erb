<%= turbo_frame_tag "scuola_adozioni" do %>
  <% prima_classe = @scuola.classi.attive.order(:anno_corso, :sezione).first %>
  <section class="group">
    <div class="flex align-center justify-between gap margin-block-end">
      <h3 class="divider divider--fade txt-medium font-weight-black margin-none" style="flex: 1;">
        <%= link_to "Mie adozioni", scuola_adozioni_path(@scuola, scope: "mie"),
            class: "txt-undecorated #{'font-weight-black' if @scope == 'mie'}",
            style: "color: inherit; #{'opacity: 0.4;' unless @scope == 'mie'}",
            data: { turbo_frame: "scuola_adozioni" } %>
        <%= link_to "Tutte", scuola_adozioni_path(@scuola, scope: "tutte"),
            class: "txt-undecorated #{'font-weight-black' if @scope == 'tutte'}",
            style: "color: inherit; #{'opacity: 0.4;' unless @scope == 'tutte'}",
            data: { turbo_frame: "scuola_adozioni" } %>
      </h3>
      <% if prima_classe %>
        <%= link_to new_scuola_classe_adozione_path(@scuola, prima_classe),
            class: "btn btn--circle btn--small",
            data: { turbo_frame: :modal, controller: "tooltip", tooltip_content_value: "Aggiungi adozioni" } do %>
          <%= icon_tag "add", size: "small" %>
          <span class="for-screen-reader">Aggiungi adozioni</span>
        <% end %>
      <% end %>
    </div>

    <%# Stato MIUR sotto il divider, centrato: qui si capisce perché l'elenco
        mostrato è quello riportato/provvisorio. %>
    <% if @scuola.fuori_anagrafe_miur? %>
      <p class="flex align-center justify-center gap-half txt-small margin-block-end">
        <span class="badge badge--yellow"><span class="badge__dot"></span> fuori anagrafe MIUR</span>
        <%= link_to "Gestisci nel controllo adozioni", controllo_adozioni_path(codicescuola: @scuola.codice_ministeriale), class: "btn btn--small", data: { turbo_frame: "_top" } %>
      </p>
    <% elsif @scuola.in_attesa_roster_miur? %>
      <p class="flex align-center justify-center gap-half txt-small margin-block-end">
        <span class="badge">in attesa adozioni MIUR <%= anno_scolastico_label(Miur.anno_corrente) %></span>
        <%= link_to "Apri nel controllo adozioni", controllo_adozioni_path(codicescuola: @scuola.codice_ministeriale), class: "btn btn--small", data: { turbo_frame: "_top" } %>
      </p>
    <% elsif @scuola.gestione_manuale? %>
      <p class="flex align-center justify-center gap-half txt-small margin-block-end">
        <span class="badge badge--grey">gestione manuale</span>
        <%= link_to "Apri nel controllo adozioni", controllo_adozioni_path(codicescuola: @scuola.codice_ministeriale), class: "btn btn--small", data: { turbo_frame: "_top" } %>
      </p>
    <% end %>

    <% if @adozioni.any? %>
      <% grouped = @adozioni.group_by(&:disciplina) %>

      <% grouped.each do |disciplina, adozioni_disciplina| %>
        <h4 class="txt-x-small txt-subtle txt-uppercase margin-block-start"><%= disciplina %></h4>

        <dl class="dl-grid dl-grid--center txt-small">
          <% per_libro = adozioni_disciplina.group_by { |a| [a.titolo, a.editore] } %>
          <% per_libro.each do |(titolo, editore), adozioni| %>
            <% disdetta = adozioni.any?(&:disdetta?) %>
            <dt class="txt-x-small <%= 'disdetta' if disdetta %>" style="line-height: 1.1;"><span class="font-weight-bold"><%= titolo %></span><br><span class="txt-xx-small txt-subtle"><%= editore %></span></dt>
            <dd>
              <div class="flex gap-quarter flex-wrap">
                <%
                  adozioni_by_classe = adozioni.group_by(&:classe_id)
                  styles = adozioni_by_classe.transform_values do |aa|
                    if aa.none?(&:da_acquistare?)
                      :grey
                    elsif aa.any? { |a| a.nuova_adozione? && a.mia? }
                      :nuova_mia
                    elsif aa.any?(&:mia?)
                      :mia
                    elsif aa.any?(&:nuova_adozione?)
                      :nuova_altri
                    end
                  end
                %>
                <%= classi_badge_links(adozioni.map(&:classe).uniq, @scuola, classe_styles: styles) %>
              </div>
            </dd>
          <% end %>
        </dl>
      <% end %>
    <% else %>
      <p class="txt-small txt-subtle margin-none">Nessuna adozione trovata.</p>
    <% end %>
  </section>
<% end %>

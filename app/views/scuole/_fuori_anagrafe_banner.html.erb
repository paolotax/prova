<%# locals: (scuola:) -%>
<%# Banner: scuola attiva col codice sparito dall'anagrafe MIUR corrente e non
    ancora promossa (promossa ciecamente = gia' gestita, niente allarme). %>
<% if scuola.fuori_anagrafe_miur? %>
  <p class="notice notice--warning flex align-center gap-half justify-between">
    <span>
      Il codice <%= scuola.codice_ministeriale %> non è più nell'anagrafe MIUR
      <%= anno_scolastico_label(Miur.anno_corrente) %> — cambio codice o soppressione.
    </span>
    <%= link_to "Gestisci nel controllo adozioni",
        controllo_adozioni_path(codicescuola: scuola.codice_ministeriale),
        class: "btn btn--small" %>
  </p>
<% end %>

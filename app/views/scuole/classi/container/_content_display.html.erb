<%# locals: (classe:, scuola:) -%>

<div class="flex align-end gap">
  <div class="card__title txt-xx-large font-weight-black">
    <%= classe.nome_breve %>
  </div>
  <div>
    <span class="card__subtitle">
      <%= classe.combinazione.presence || classe.tipo_scuola %>
      <% if classe.numero_alunni.present? && classe.numero_alunni > 0 %>
        — <%= classe.numero_alunni %> alunni
      <% end %>
    </span>
  </div>
</div>

<% if classe.note.present? %>
  <div class="card__description margin-block-start">
    <p class="txt-small margin-none"><%= simple_format(classe.note) %></p>
  </div>
<% end %>

<%= render "scuole/classi/container/docenti", classe: classe, scuola: scuola %>

<%
  mie_adozioni = Adozione.correnti.where(classe: classe, mia: true, da_acquistare: true)
                         .includes(:libro, :consegne_saggio)
                         .order(:titolo)
%>
<% if mie_adozioni.any? %>
  <style>
    /* Elimina a comparsa in hover sull'avatar, come i fascicoli nella show libro. */
    .adozione-tile { position: relative; }
    .adozione-tile__remove {
      position: absolute; top: -6px; right: -6px;
      opacity: 0; transition: opacity .15s ease;
    }
    .adozione-tile:hover .adozione-tile__remove,
    .adozione-tile:focus-within .adozione-tile__remove { opacity: 1; }
  </style>
  <div class="flex gap-half flex-wrap margin-block-start">
    <% mie_adozioni.each do |adozione| %>
      <div class="flex flex-column align-center gap-quarter adozione-tile" id="<%= dom_id(adozione, :tile) %>">
        <% if adozione.libro %>
          <%= link_to adozione.libro, data: { turbo_frame: "_top", controller: "tooltip" }, title: adozione.titolo do %>
            <%= copertina_tag adozione.libro, class: "copertina--shadow", style: "--copertina-size: 80px;" %>
          <% end %>
        <% end %>
        <%= button_to scuola_classe_adozione_path(scuola, classe, adozione),
              method: :delete,
              class: "adozione-tile__remove btn btn--negative btn--remove txt-x-small",
              form: { data: { turbo_frame: "_top" } },
              data: { controller: "tooltip", tooltip_content_value: "Elimina adozione",
                      turbo_confirm: "Eliminare #{adozione.titolo}?" } do %>
          <%= icon_tag "close" %>
          <span class="for-screen-reader">Elimina</span>
        <% end %>
        <div class="flex gap-quarter flex-wrap justify-center">
          <% adozione.saggi.each do |cs| %>
            <%= button_to scuola_classe_consegne_saggio_path(scuola, classe, cs),
                method: :delete,
                class: "badge txt-xx-small cursor-pointer",
                style: "background: #EAB308; color: white; border: none; padding: 2px 6px;",
                data: { turbo_confirm: "Eliminare saggio?" } do %>S<% end %>
          <% end %>
          <% adozione.kit_consegne.each do |cs| %>
            <%= button_to scuola_classe_consegne_saggio_path(scuola, classe, cs),
                method: :delete,
                class: "badge txt-xx-small cursor-pointer",
                style: "background: #FF1493; color: white; border: none; padding: 2px 6px;",
                data: { turbo_confirm: "Eliminare kit?" } do %>K<% end %>
          <% end %>
          <% adozione.seguiti.each do |cs| %>
            <%= button_to scuola_classe_consegne_saggio_path(scuola, classe, cs),
                method: :delete,
                class: "badge txt-xx-small cursor-pointer",
                style: "background: #0080FF; color: white; border: none; padding: 2px 6px;",
                data: { turbo_confirm: "Eliminare seguito?" } do %>F<% end %>
          <% end %>
          <% if adozione.saggi.empty? %>
            <%= button_to scuola_classe_consegne_saggio_index_path(scuola, classe),
                params: { adozione_id: adozione.id, tipo: "saggio" },
                class: "badge txt-xx-small cursor-pointer",
                style: "background: var(--color-ink-lightest); color: var(--color-ink-light); border: none; padding: 2px 6px;" do %>+S<% end %>
          <% end %>
          <% if adozione.kit_consegne.empty? %>
            <%= button_to scuola_classe_consegne_saggio_index_path(scuola, classe),
                params: { adozione_id: adozione.id, tipo: "kit" },
                class: "badge txt-xx-small cursor-pointer",
                style: "background: var(--color-ink-lightest); color: var(--color-ink-light); border: none; padding: 2px 6px;" do %>+K<% end %>
          <% end %>
          <% if adozione.seguiti.empty? %>
            <%= button_to scuola_classe_consegne_saggio_index_path(scuola, classe),
                params: { adozione_id: adozione.id, tipo: "seguito" },
                class: "badge txt-xx-small cursor-pointer",
                style: "background: var(--color-ink-lightest); color: var(--color-ink-light); border: none; padding: 2px 6px;" do %>+F<% end %>
          <% end %>
        </div>
      </div>
    <% end %>

    <%= link_to new_scuola_classe_adozione_path(scuola, classe, fissa: 1),
          class: "btn btn--circle btn--small",
          style: "align-self: center; margin-inline-start: 0.5em;",
          data: { turbo_frame: :modal, controller: "tooltip", tooltip_content_value: "Aggiungi adozione" } do %>
      <%= icon_tag "add", size: "small" %>
      <span class="for-screen-reader">Aggiungi adozione</span>
    <% end %>
  </div>
<% end %>

<%= turbo_frame_tag :modal do %>
  <div data-controller="dialog classe-form"
       data-dialog-modal-value="true"
       data-dialog-auto-open-value="true">
    <dialog class="dialog panel" style="--panel-size: 44ch;"
            data-dialog-target="dialog"
            data-action="keydown.esc->dialog#close:stop">
      <h3 class="txt-large txt-bold">Aggiungi adozione</h3>
      <p class="txt-small txt-subtle margin-block-end"><%= @scuola.denominazione %></p>

      <% if @adozione.errors[:codice_isbn].present? %>
        <p class="txt-small txt-negative margin-block-end" role="alert">
          Questo libro è già presente in questa classe.
        </p>
      <% end %>

      <%= form_with model: @adozione,
          url: scuola_classe_adozioni_path(@scuola, @classe),
          method: :post,
          class: "flex flex-column gap",
          data: { classe_form_target: "form" } do |f| %>

        <div class="flex flex-column gap-quarter">
          <label class="txt-small txt-bold" for="classe_id">Classe</label>
          <select name="classe_id" id="classe_id" class="input input--select"
                  data-classe-form-target="select"
                  data-action="change->classe-form#updateAction">
            <% @classi.each do |classe| %>
              <option value="<%= classe.id %>"
                      data-url="<%= scuola_classe_adozioni_path(@scuola, classe) %>"
                      <%= "selected" if classe.id == @classe.id %>>
                <%= classe.nome_breve %>
              </option>
            <% end %>
          </select>
        </div>

        <div class="flex flex-column gap-quarter">
          <label class="txt-small txt-bold" for="libro_id">Libro</label>
          <%= f.combobox :libro_id, libri_path,
              placeholder: "Cerca libro...",
              class: "input" %>
        </div>

        <div class="flex flex-column gap-half margin-block-start">
          <label class="flex align-center gap-half txt-small">
            <%= check_box_tag :da_acquistare, "1", @adozione.da_acquistare %>
            Da acquistare
          </label>
          <label class="flex align-center gap-half txt-small">
            <%= check_box_tag :nuova_adozione, "1", @adozione.nuova_adozione %>
            Nuova adozione
          </label>
          <label class="flex align-center gap-half txt-small">
            <%= check_box_tag :consigliato, "1", @adozione.consigliato %>
            Consigliato
          </label>
        </div>

        <div class="flex gap-half justify-end margin-block-start">
          <button type="button" class="btn" data-action="dialog#close">Annulla</button>
          <%= f.submit "Aggiungi", class: "btn btn--link" %>
        </div>
      <% end %>

    </dialog>
  </div>
<% end %>

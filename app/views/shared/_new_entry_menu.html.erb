<%# locals: (record:) -%>
<%# Menu "nuovo" delle schede (classe, scuola, persona): appunto oppure
    documento con la causale già scelta, intestati al record della scheda.
    Le causali dipendono dal tipo di intestatario; "Altro documento" apre
    il form vuoto senza causale preimpostata. %>
<% causali_menu = case record
     when Classe, Scuola then ["Ordine Scuola", "Conto visione", "Scarico saggi"]
     else ["Ordine Cliente", "Documento di trasporto", "Conto visione", "Scarico saggi"]
   end %>

<div id="<%= dom_id(record, :new_entry_menu) %>" data-controller="dialog" data-dialog-modal-value="true"
     data-action="keydown.esc->dialog#close">
  <button type="button" class="btn" data-controller="tooltip"
      data-tooltip-content-value="Nuovo appunto o documento"
      data-action="click->dialog#toggle">
    <%= icon_tag "note" %>
    <span class="for-screen-reader">Nuovo appunto o documento</span>
  </button>

  <dialog class="popup popup--modal panel flex-column gap fill-white shadow txt-small" data-dialog-target="dialog"
      style="--panel-size: 16rem; min-inline-size: 0;"
      data-action="click->dialog#closeOnBackdrop">
    <ul class="popup__list gap-half">
      <li class="popup__item">
        <%# turbo_prefetch false: appunti#new CREA la bozza, niente prefetch %>
        <%= link_to new_appunto_path(appuntabile_type: record.class.name, appuntabile_id: record.id),
              class: "popup__btn btn", data: { turbo_frame: "_top", action: "click->dialog#close", turbo_prefetch: false } do %>
          <%= icon_tag "note" %>
          <span>Appunto</span>
        <% end %>
      </li>

      <% causali_menu.each do |causale| %>
        <li class="popup__item">
          <%= link_to new_documento_path(causale: causale, clientable_type: record.class.name, clientable_id: record.id),
                class: "popup__btn btn", data: { turbo_frame: "_top", action: "click->dialog#close" } do %>
            <%= icon_tag "document" %>
            <span><%= causale %></span>
          <% end %>
        </li>
      <% end %>

      <li class="popup__item">
        <%= link_to new_documento_path(clientable_type: record.class.name, clientable_id: record.id),
              class: "popup__btn btn", data: { turbo_frame: "_top", action: "click->dialog#close" } do %>
          <%= icon_tag "add" %>
          <span>Altro documento</span>
        <% end %>
      </li>
    </ul>
  </dialog>
</div>

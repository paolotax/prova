<% @page_title = @scheda.denominazione.presence || @scheda.codicescuola %>

<% content_for :header do %>
  <div class="header__actions header__actions--start">
    <% info = referrer_back_info || { label: "Controllo", path: controllo_adozioni_index_path(account_id: params[:account_id]) } %>
    <%= back_link_to info[:label], info[:path] %>
  </div>

  <h1 class="header__title divider divider--fade full-width">
    <span class="overflow-ellipsis"><%= @scheda.denominazione.presence || @scheda.codicescuola %></span>
    <% if @scheda.scuola&.gestione_manuale? %>
      <span class="badge badge--grey">gestione manuale</span>
    <% end %>
  </h1>

  <div class="header__actions header__actions--end">
    <% unless @scheda.promossa? %>
      <%= link_to "Passaggio anno",
          new_controllo_adozioni_promozione_path(codicescuola: @scheda.codicescuola, account_id: params[:account_id]),
          class: "btn", data: { turbo_frame: :modal } %>
    <% end %>

    <% if @scheda.promozione_cieca_possibile? %>
      <%= link_to "Promozione cieca",
          new_controllo_adozioni_promozione_cieca_path(codicescuola: @scheda.codicescuola, account_id: params[:account_id]),
          class: "btn", data: { turbo_frame: :modal } %>
    <% end %>
  </div>
<% end %>

<div class="ca-page">
  <p class="txt-subtle txt-small"><%= @scheda.codicescuola %></p>

  <% if @scheda.scuola&.gestione_manuale? %>
    <p class="flex align-center gap-half txt-subtle txt-small">
      <span>Scuola tenuta fuori dai controlli automatici sull'anagrafe MIUR.</span>
      <%= button_to "Rimuovi gestione manuale",
          controllo_adozioni_gestione_manuale_path(codicescuola: @scheda.codicescuola, account_id: params[:account_id]),
          method: :delete, class: "btn btn--small" %>
    </p>
  <% end %>

  <div class="flex gap-half margin-block-end">
    <% @scheda.anni_anteprima.each do |anno| %>
      <% con_elenco = @scheda.anni_con_elenco.include?(anno) %>
      <span class="flex flex-column gap-quarter">
        <%= link_to "Anteprima #{anno_scolastico_label(anno)}",
              controllo_adozioni_anteprima_path(@scheda.codicescuola, anno: anno, account_id: params[:account_id]),
              class: "btn#{' btn--subtle' unless con_elenco}" %>
        <% unless con_elenco %>
          <span class="txt-x-small txt-subtle">(elenco non disponibile)</span>
        <% end %>
      </span>
    <% end %>
  </div>

  <% if @scheda.fuori_anagrafe? %>
    <div class="notice notice--warning flex flex-column gap">
      <p>
        Il codice <strong><%= @scheda.codicescuola %></strong> non è più nell'anagrafe MIUR
        <%= anno_scolastico_label(@scheda.anno_corrente) %> — cambio codice o soppressione.
      </p>

      <% if @scheda.successori.any? %>
        <div class="flex flex-column gap-half">
          <h3 class="txt-small txt-bold">Possibili successori</h3>
          <% @scheda.successori.each do |candidato| %>
            <div class="flex align-center gap-half justify-between">
              <span class="txt-small">
                <strong><%= candidato.denominazione %></strong>
                — <%= candidato.comune %> (<%= candidato.codice_scuola %>)
              </span>
              <%= link_to "Aggiorna codice → #{candidato.codice_scuola}",
                  new_controllo_adozioni_promozione_path(codicescuola: @scheda.codicescuola,
                    codice_nuovo: candidato.codice_scuola, account_id: params[:account_id]),
                  class: "btn btn--small", data: { turbo_frame: :modal } %>
            </div>
          <% end %>
        </div>
      <% end %>

      <div class="flex gap-half">
        <%= button_to "Archivia (soppressa)",
            controllo_adozioni_archiviazione_path(codicescuola: @scheda.codicescuola, account_id: params[:account_id]),
            method: :post, class: "btn btn--negative",
            data: { turbo_confirm: "Archiviare la scuola e tutte le classi attive? Le adozioni escono dai conteggi." } %>
        <%= button_to "Gestione manuale",
            controllo_adozioni_gestione_manuale_path(codicescuola: @scheda.codicescuola, account_id: params[:account_id]),
            method: :post, class: "btn" %>
      </div>
    </div>
  <% end %>

  <% if @scheda.scuola_mancante? %>
    <p class="notice notice--warning">
      Scuola assente dall'anagrafe MIUR corrente (adozioni orfane)
    </p>
  <% end %>

  <div class="badges">
    <% @scheda.per_tipo.each do |tipo, count| %>
      <span class="badge"><%= tipo %>: <%= count %></span>
    <% end %>
  </div>

  <% if @scheda.scuola %>
    <section class="margin-block-end">
      <h2 class="txt-medium">In anagrafe: <%= link_to @scheda.scuola.denominazione, scuola_path(@scheda.scuola, account_id: params[:account_id]) %></h2>
      <table class="table">
        <thead>
          <tr>
            <th>Anno</th>
            <th class="txt-align-end">Classi attive</th>
            <th class="txt-align-end">Archiviate</th>
            <th class="txt-align-end">Adozioni</th>
          </tr>
        </thead>
        <tbody>
          <% @scheda.confronto_anni.each do |riga| %>
            <tr>
              <td><%= anno_scolastico_label(riga.anno) %></td>
              <td class="txt-align-end"><%= riga.classi_attive %></td>
              <td class="txt-align-end"><%= riga.classi_archiviate %></td>
              <td class="txt-align-end"><%= riga.adozioni %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </section>
  <% else %>
    <p class="txt-subtle">Scuola non ancora in anagrafe.</p>
  <% end %>

  <% @scheda.per_classe.each do |(annocorso, sezioneanno, combinazione), anomalie| %>
    <section class="classe-block">
      <h2 class="classe-block__title">Classe <%= annocorso %><%= sezioneanno %></h2>
      <ul class="anomalie-list list-style-none">
        <% anomalie.each do |anomalia| %>
          <%= render "controllo_adozioni/anomalia", anomalia: anomalia %>
        <% end %>
      </ul>

      <% if anomalie.any? { |a| %w[tetto_superato disciplina_mancante].include?(a.tipo) } %>
        <% libri = @scheda.libri_per_classe[[annocorso, sezioneanno, combinazione]] || [] %>
        <% if libri.any? %>
          <table class="table">
            <thead>
              <tr>
                <th>Disciplina</th>
                <th>Titolo</th>
                <th>Editore</th>
                <th class="txt-align-end">Prezzo</th>
              </tr>
            </thead>
            <tbody>
              <% libri.each do |libro| %>
                <tr class="<%= "txt-subtle" if libro.escluso_dal_tetto? %>">
                  <td><%= libro.disciplina %></td>
                  <td>
                    <%= libro.titolo %><%= " #{libro.volume}" if libro.volume.present? %>
                    <% if libro.escluso_dal_tetto? %>
                      <span class="txt-small">(esclusa dal totale)</span>
                    <% end %>
                  </td>
                  <td><%= libro.editore %></td>
                  <td class="txt-align-end">
                    <%= libro.prezzo_euro ? number_to_currency(libro.prezzo_euro) : "—" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
            <tfoot>
              <tr>
                <th colspan="3" class="txt-align-end">Totale spesa classe</th>
                <th class="txt-align-end">
                  <%= number_to_currency(libri.reject(&:escluso_dal_tetto?).sum { |l| l.prezzo_euro || 0 }) %>
                </th>
              </tr>
            </tfoot>
          </table>
        <% end %>
      <% end %>
    </section>
  <% end %>

  <% if @scheda.anomalie.empty? %>
    <p class="txt-subtle">Nessuna anomalia per questa scuola.</p>
  <% end %>
</div>
